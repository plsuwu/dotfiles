# this is a little verbose but i find the zsh syntax kind of cumbersome to
# read, so its written this way for the sake of my own future sanity...
prompt_violet_setup () {
    prompt_opts=(subst percent)

    # reset foreground or background
    local -A uset=(
        [_fg]="%f"
        [_bg]="%k"
        [all]="%f%k"
    )
    
    # sets coloring
    local -A cols=(
        [base]="15"
        [white]="255"
        [userfg]=${${SSH_CLIENT+"153"}:-"147"}
        [hostbg]=${${SSH_CLIENT+"33"}:-"99"}
    )
    
    # builds part of the prompt
    local -A lp=(
        [user]="%F{$cols[userfg]}%U%n%u$uset[_fg]"
        [host]="%F{$cols[white]}%K{$cols[hostbg]}%m$uset[all]"
        [sep]="%F{$cols[white]}%B@%b$uset[_fg]"
        [open_br]="%F{$cols[base]}[$uset[_fg]"
        [close_br]="%F{$cols[base]}]$uset[_fg]"
        [curr_wd]="%F{$cols[base]}%~$uset[_fg]"
    )

    autoload -Uz vcs_info

    zstyle ':vcs_info:git:*' check-for-changes true
    zstyle ':vcs_info:git:*' formats '(%F{230}%r%f):on %F{111}%b%f'

    PS1="$lp[open_br]$lp[user]$lp[sep]$lp[host]$lp[close_br]$lp[open_br]$lp[curr_wd]$lp[close_br]%(#.#.$) "
    RPS1="\$vcs_info_msg_0_"


    add-zsh-hook precmd prompt_violet_precmd
}

prompt_violet_precmd () {
    vcs_info
}

prompt_violet_setup "$@"

